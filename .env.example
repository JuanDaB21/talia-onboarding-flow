# Plantilla de entorno para la rama `deployment` (Railway). Copia a `.env` y completa.
# El `.env` real está gitignored (no lo pises con lo de Lovable).

# API del backend Talia en Railway (dev). Incluye el sufijo /api.
VITE_API_URL=https://talia-backend-dev.up.railway.app/api

# WebSocket de realtime del backend (mismo host, esquema wss).
VITE_WS_URL=wss://talia-backend-dev.up.railway.app

# Ambiente
VITE_APP_ENV=development

# Storage de imágenes: por ahora se mantiene Supabase Storage (solo archivos, no datos).
# Deja estas si el cutover aún usa Supabase para imágenes de productos/logos.
VITE_SUPABASE_URL=https://bstuxgnyvjlpbynxikph.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
