# Nitro 3 beta (via unstorage) declara peers OPCIONALES (p.ej. lru-cache@^11) que
# distintas versiones de npm reconcilian de forma distinta: npm 11 los poda del
# lockfile, npm 10 (el del build en Railway/node 22) intenta instalarlos y falla
# `npm ci` con "Missing: lru-cache@X from lock file". Ignorar los peers uniformiza el
# árbol entre entornos y mantiene el lockfile consistente. NO usar omit=optional: eso
# eliminaría los binarios nativos de Rollup por plataforma (son optionalDependencies).
legacy-peer-deps=true
